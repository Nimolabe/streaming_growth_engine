# Local development only. Never commit real keys, secrets or user data.
SGE_ENV=development
# LLM_API_KEY=replace-with-your-own-key

# Optional live LLM calls: never store a real key in Git!
# OPENAI_API_KEY=... (set in your local shell or secrets manager)
# Explicit model choice is required before a live call:
SGE_LLM_MODEL=
# The following are estimated pricing inputs, NOT guaranteed hard spending limits.
# Verify actual current per-million-token rates before each test.
SGE_INPUT_USD_PER_M=1.0
SGE_OUTPUT_USD_PER_M=5.0
SGE_ESTIMATED_MAX_USD=0.02

# Clip Hunter: optional für VOD-Startzeit und Zuschauer-Clips (kostenlose App unter
# https://dev.twitch.tv/console). Nur lokal setzen, nie committen.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
