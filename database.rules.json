{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "usernames": {
      ".read": true,
      "$name": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && newData.parent().parent().child('profiles').child(auth.uid).child('usernameLower').val() === $name) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $name.length >= 3 && $name.length <= 20 && $name.matches(/^[a-z0-9_]+$/)"
      }
    },

    "profiles": {
      ".read": true,
      ".indexOn": ["usernameLower", "nameLower", "createdAt"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'username', 'usernameLower', 'nameLower', 'createdAt']) && newData.parent().parent().child('usernames').child(newData.child('usernameLower').val()).val() === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "nameLower": { ".validate": "newData.isString() && newData.val() === newData.parent().child('name').val().toLowerCase()" },
        "username": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && newData.val().matches(/^[A-Za-z0-9_]+$/)" },
        "usernameLower": { ".validate": "newData.isString() && newData.val() === newData.parent().child('username').val().toLowerCase()" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 280" },
        "platform": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'twitch' || newData.val() === 'youtube' || newData.val() === 'kick' || newData.val() === 'tiktok' || newData.val() === 'andere')" },
        "channel": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && newData.val().length >= 11 && newData.val().length <= 200))" },
        "games": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "$other": { ".validate": false }
      }
    },

    "layouts": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['params', 'updatedAt'])",
        "params": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    },

    "following": {
      "$uid": {
        ".read": true,
        "$target": {
          ".write": "auth != null && auth.uid === $uid && $target !== $uid",
          ".validate": "newData.val() === true && newData.parent().parent().parent().child('profiles').child($target).exists()"
        }
      }
    },

    "waitlist": {
      "$feature": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && $feature === 'clipHunter'",
          ".write": "auth != null && auth.uid === $uid && $feature === 'clipHunter'",
          ".validate": "newData.hasChildren(['createdAt'])",
          "createdAt": { ".validate": "newData.isNumber() && (newData.val() === now || (data.exists() && newData.val() === data.val()))" },
          "platform": { ".validate": "newData.isString() && (newData.val() === 'twitch' || newData.val() === 'youtube' || newData.val() === 'kick' || newData.val() === 'tiktok' || newData.val() === 'andere')" },
          "$other": { ".validate": false }
        }
      }
    },

    "socialIcons": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "tw": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 40000" },
        "yt": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 40000" },
        "tt": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 40000" },
        "ig": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 40000" },
        "x": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length <= 40000" },
        "$other": { ".validate": false }
      }
    },

    "followers": {
      "$uid": {
        ".read": true,
        "$follower": {
          ".write": "auth != null && auth.uid === $follower && $follower !== $uid",
          ".validate": "newData.val() === true && newData.parent().parent().parent().child('following').child($follower).child($uid).val() === true"
        }
      }
    }
  }
}
